    consumeRequiredItem: 0
    requiredLoyalNpc: {fileID: 0}
    actions: []
    rewardTrackingId: 165d02140a2948b3a644d92105e8680a
  - text: "\u041E\u0442\u043E\u0439\u0434\u0438\u0442\u0435. \u042F \u043D\u0435
