  text: "\u0410 \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F
    \u2014 \u043D\u0430\u0441\u0438\u043B\u044C\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435."
  options:
  - text: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E?"
    nextDialogue: {fileID: 11400000, guid: 82ce517074275b949ba94ed0b7a35bf6, type: 2}
