  playerName: 
  playerPortrait: {fileID: -7710925141277411097, guid: c2ed5c7a68c54714bb084319d6310399, type: 3}
  npcName: "\u041B\u0438\u0441"
  npcPortrait: {fileID: 725976524088372361, guid: 90c216749bde8d7458e0f1febb50fe93, type: 3}
  text: "\u0410 \u043D\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u0442\u0432\u043E\u0438
    \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F. \u041D\u0430\u043C
    \u043D\u0443\u0436\u043D\u044B \u0434\u0435\u043D\u044C\u0433\u0438."
  options:
  - text: "\u041C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u0432\u0430\u0448\u0438
      \u044D\u043A\u0441\u043A\u0443\u0440\u0441\u0438\u0438. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043C\u0435\u043D\u044F"
    nextDialogue: {fileID: 11400000, guid: e2f96ce5d49e8a34ab4c6ed5c39fc4fb, type: 2}
    useCondition: 0
    conditionLogic: 0
    requireItem: 0
    requireLoyalty: 0
    requiredItem: {fileID: 0}
    consumeRequiredItem: 0
    requiredLoyalNpc: {fileID: 0}
    actions: []
    rewardTrackingId: d02580e6d6ae45a6856127a24807a339
  - text: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0443 \u043C\u0435\u043D\u044F \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435\u0442. \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435,
      \u0438 \u044F \u0432\u0435\u0440\u043D\u0443\u0441\u044C."
    nextDialogue: {fileID: 11400000, guid: 2aa7fc85df4d980438fe14727c39f7ca, type: 2}
    useCondition: 0
    conditionLogic: 0
    requireItem: 0
    requireLoyalty: 0
    requiredItem: {fileID: 0}
    consumeRequiredItem: 0
    requiredLoyalNpc: {fileID: 0}
    actions: []
    rewardTrackingId: 94eb0e74d8ad4d4cbcc04fb3316206de
  - text: "\u042F \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u0435\u0437\u0435\u043D.
      \u0412\u0430\u043C \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043D\u0443\u0436\u043D\u043E?"
