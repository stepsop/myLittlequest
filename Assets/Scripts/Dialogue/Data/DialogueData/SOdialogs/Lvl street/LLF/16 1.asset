  text: "\u0413\u0435\u0440\u043E\u0439 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
    \u0431\u0443\u0442\u044B\u043B\u043A\u0443 \u0438 \u0441 \u0441\u0438\u043B\u043E\u0439
    \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u0442 \u0435\u0451 \u043E\u0431
    \u0441\u0442\u0435\u043D\u0443. \u041E\u0441\u043A\u043E\u043B\u043A\u0438 \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E \u043C\u043E\u043A\u0440\u043E\u0439 \u043C\u043E\u0441\u0442\u043E\u0432\u043E\u0439.\n"
  options:
  - text: "\u0414\u0430 \u043F\u043E\u0448\u043B\u0438 \u0432\u044B \u0432\u0441\u0435
      \u043A \u0447\u0451\u0440\u0442\u0443! \u0414\u0443\u043C\u0430\u0435\u0442\u0435,
      \u0432\u0430\u0441 \u0442\u0440\u043E\u0435 \u2014 \u0438 \u0432\u044B \u0437\u0434\u0435\u0441\u044C
      \u0445\u043E\u0437\u044F\u0435\u0432\u0430?! \u042F \u0432\u0430\u043C \u0441\u0435\u0439\u0447\u0430\u0441
      \u0433\u043B\u043E\u0442\u043A\u0438 \u043F\u0435\u0440\u0435\u0440\u0435\u0436\u0443!"
