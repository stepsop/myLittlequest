%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 212f64f59e0892b4b892c0cda2231efb, type: 3}
  m_Name: Lynx
  m_EditorClassIdentifier: Assembly-CSharp::FailPhraseDatabase
  phrases:
  - text: "\u041E\u0442\u044A\u0435\u0431\u0438\u0441\u044C, \u0430? \u041D\u0435
      \u0434\u043E \u0442\u0432\u043E\u0438\u0445 \u0441\u043E\u043F\u043B\u0435\u0439
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u0431\u043E\u0442
      \u043F\u043E \u0433\u043E\u0440\u043B\u043E"
    audio: {fileID: 8300000, guid: aaefd4a985d771b4cb5183b6849525b6, type: 3}
    used: 1
  - text: "\u042F \u0433\u043B\u0443\u0445\u0430\u044F \u0434\u043B\u044F \u0447\u0443\u0436\u0438\u0445
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C."
    audio: {fileID: 8300000, guid: 42b0676cacb98a54d957bbf7633df6b4, type: 3}
    used: 1
  - text: "\u0417\u0430\u0445\u043B\u043E\u043F\u043D\u0438 \u0432\u0430\u0440\u0435\u0436\u043A\u0443.
      \u041C\u0435\u043D\u044F \u0432 \u043F\u0440\u0438\u044E\u0442\u0435 \u0442\u0430\u043A\u0438\u0435
      \u0434\u0443\u0448\u043D\u044B\u0435 \u0442\u0438\u043F\u044B \u0435\u0449\u0435
      \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0437\u0430\u0435\u0431\u0430\u043B\u0438."
    audio: {fileID: 8300000, guid: ce0a82e30ef11e14e8273cbfbef8e929, type: 3}
    used: 0
  - text: "\u0428\u0430\u0433 \u043D\u0430\u0437\u0430\u0434 \u0441\u0434\u0435\u043B\u0430\u0439,
      \u043F\u043E\u043A\u0430 \u044F \u0442\u0435\u0431\u0435 \u0437\u0443\u0431\u044B
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B\u0430."
    audio: {fileID: 8300000, guid: 3c6d27b7751cbed4bb75b27ff667b543, type: 3}
    used: 1
  - text: "\u0421\u043B\u0443\u0448\u0430\u0439, \u0438\u0441\u0447\u0435\u0437\u043D\u0438.
      \u042F \u0434\u043E\u0432\u0435\u0440\u044F\u044E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u0432\u043E\u0438\u043C \u0432 \u044D\u0442\u043E\u0439 \u0434\u044B\u0440\u0435,
      \u0438 \u0442\u0432\u043E\u0435\u0439 \u0440\u043E\u0436\u0438 \u0432 \u044D\u0442\u043E\u043C
      \u0441\u043F\u0438\u0441\u043A\u0435 \u043D\u0435\u0442"
    audio: {fileID: 8300000, guid: 4c13ea8e0588601449236a10f405a845, type: 3}
    used: 1
  - text: "\u0425\u0443\u043B\u0438 \u0442\u044B \u043A\u0440\u0443\u0442\u0438\u0448\u044C\u0441\u044F
      \u0442\u0443\u0442? \u0418\u0434\u0438 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C
      \u0447\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u0430\u0439\u043C\u0438\u0441\u044C,
      \u043F\u043E\u043A\u0430 \u043F\u043E \u0448\u0435\u0435 \u043D\u0435 \u0441\u0445\u043B\u043E\u043F\u043E\u0442\u0430\u043B"
    audio: {fileID: 8300000, guid: c29d42b60b2ed2041aaad1bb424bd9e6, type: 3}
    used: 1
  - text: "\u042F \u043F\u043E\u0445\u043E\u0436\u0430 \u043D\u0430 \u0442\u0443,
      \u043A\u043E\u043C\u0443 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E
      \u0442\u0432\u043E\u0451 \u043D\u044B\u0442\u044C\u0451? \u0412\u043E\u0442
      \u0438 \u043D\u0435 \u043B\u0435\u0437\u044C \u043A\u043E \u043C\u043D\u0435
      \u043F\u043E\u0434 \u0440\u0443\u043A\u0443."
    audio: {fileID: 8300000, guid: 365419001037f4e4faaa498cce37ac75, type: 3}
    used: 1
  - text: "\u0421\u0431\u0430\u0432\u044C \u043E\u0431\u043E\u0440\u043E\u0442\u044B."
    audio: {fileID: 8300000, guid: 22a4b999a156fa84bb656f7f4654fb72, type: 3}
    used: 0
  - text: "\u0415\u0449\u0451 \u043E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E
      \u2014 \u0438 \u044F \u0437\u0430\u0431\u0443\u0434\u0443, \u0447\u0442\u043E
      \u0443 \u043C\u0435\u043D\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435.
      \u0421\u0432\u0430\u043B\u0438 \u0432 \u0442\u0443\u043C\u0430\u043D"
    audio: {fileID: 8300000, guid: ebd83b64643207943a351c15bd7a4c6b, type: 3}
    used: 0
